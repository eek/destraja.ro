[Unit]
Description=Paginile actelor destrajă.ro (127.0.0.1:8090; publice ca destraja.ro/acte, prin Worker-ul site-ului și tunelul destraja-search)
After=network.target
ConditionPathExists=/srv/acte/release/current/server.mjs

[Service]
User=acte
Group=acte
# Calea trece prin legătura release/current: la fiecare repornire rulează versiunea activă.
ExecStart=/opt/node/bin/node --disable-warning=ExperimentalWarning --max-old-space-size=640 /srv/acte/release/current/server.mjs --root /srv/acte --port 8090 --host 127.0.0.1
# Serverul iese singur când vede o versiune nouă; systemd îl pornește din nou.
Restart=always
RestartSec=2
Environment=NODE_ENV=production UV_THREADPOOL_SIZE=2
# ACTE_ORIGIN_KEY (cheia Worker-ului) și ACTE_OPEN_HOSTS (gazde fără cheie, doar cât durează mutarea), scrise de
# vm/origin-key.sh; root:acte 0640. Lipsa fișierului lasă serverul deschis (ca înainte).
EnvironmentFile=-/etc/acte/origin.env
StateDirectory=acte
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/srv/acte
# VM-ul e comun cu API-ul de căutare (cauta.destraja.ro): limite fixe, iar la lipsă de memorie pleacă întâi acesta.
MemoryHigh=850M
MemoryMax=1G
CPUQuota=150%
TasksMax=64
LimitNOFILE=4096
OOMScoreAdjust=300
Nice=5

[Install]
WantedBy=multi-user.target
