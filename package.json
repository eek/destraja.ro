{
  "name": "la-straja-legi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "wrangler dev",
    "straja:sync": "node scripts/straja-sync.mjs",
    "straja:council": "node scripts/straja-council.mjs",
    "straja:docx": "node scripts/straja-docx.mjs",
    "straja:news": "node scripts/straja-news.mjs",
    "deploy": "wrangler d1 migrations apply lastraja --remote && next build && wrangler deploy",
    "preview": "next build && wrangler dev",
    "straja:reports": "node scripts/straja-reports.mjs",
    "straja:digest": "node scripts/straja-digest.mjs",
    "straja:daily": "node scripts/straja-daily.mjs",
    "db:migrate": "wrangler d1 migrations apply lastraja --remote"
  },
  "dependencies": {
    "docx": "^9.1.0",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2",
    "wrangler": "^4.148.0"
  }
}
