/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Imaginile de previzualizare n-au extensie; fără asta ar pleca drept application/octet-stream.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Două segmente: /legi/…, /camera/… (fără regula asta plecau fără Content-Type), /parlamentari/…,
# /monitorul-oficial/inainte-de-1990.
/:section/:slug/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

/:page/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Datele React ale fiecărei pagini (/legi/b517-2026.txt etc.), cerute de navigarea din site; nu sunt pagini de căutat.
/*.txt
  X-Robots-Tag: noindex

# Citările fiecărui proiect (/citari/<slug>.json), citite de pagina lui în browser; nici ele nu sunt de căutat.
/citari/*
  X-Robots-Tag: noindex
