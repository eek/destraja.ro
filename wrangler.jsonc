{
  // `npm run build` produce site-ul static în out/. Worker-ul din worker/index.ts răspunde doar
  // la /api/* (rapoartele de erori și alertele pe e-mail); restul cererilor vin direct din out/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lastraja",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "lastraja", "database_id": "44d27d60-fce7-485b-ab48-b632623c36ef", "migrations_dir": "migrations" }],
  // Cel mult 5 rapoarte pe minut de la aceeași adresă, în fiecare locație Cloudflare.
  "ratelimits": [
    { "name": "REPORT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "SUBSCRIBE_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "SEARCH_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  // E-mailurile pleacă prin Resend (worker/mail.ts), cu secretele RESEND_API_KEY și RESEND_WEBHOOK_SECRET puse cu
  // `wrangler secret put`; nu au nevoie de nimic aici.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Confirmările de abonare rămase la coadă când trimiterea n-a mers din motive care nu țin de adresă (worker/subscribe.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [
    { "pattern": "destraja.ro", "custom_domain": true },
    // Domeniile vechi și cel pentru Moldova: paginile lor trimit 301 spre destraja.ro (reguli Single Redirect pe zonă);
    // /api/* rămâne aici, ca linkurile de dezabonare din e-mailurile deja trimise să meargă în continuare.
    { "pattern": "lastraja.ro", "custom_domain": true },
    { "pattern": "destraja.md", "custom_domain": true },
    // www.destraja.ro și destrajă.ro (cu ă, aici în punycode), cu www: tot 301 spre destraja.ro, din aceleași reguli.
    { "pattern": "www.destraja.ro", "custom_domain": true },
    { "pattern": "xn--destraj-f4a.ro", "custom_domain": true },
    { "pattern": "www.xn--destraj-f4a.ro", "custom_domain": true }
  ]
}
