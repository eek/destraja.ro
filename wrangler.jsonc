{
  // `npm run build` produce site-ul static în out/. Worker-ul din worker/index.ts răspunde doar
  // la /api/* (rapoartele de erori); restul cererilor sunt servite direct din out/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lastraja",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "lastraja", "database_id": "44d27d60-fce7-485b-ab48-b632623c36ef", "migrations_dir": "migrations" }],
  // Cel mult 5 rapoarte pe minut de la aceeași adresă, în fiecare locație Cloudflare.
  "ratelimits": [{ "name": "REPORT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [{ "pattern": "lastraja.ro", "custom_domain": true }]
}
