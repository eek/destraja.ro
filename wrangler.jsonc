{
  // `npm run build` produce site-ul static în out/. Worker-ul din worker/index.ts răspunde doar
  // la /api/* (rapoartele de erori și alertele pe e-mail), la /admin* (panoul rapoartelor, care verifică
  // JWT-ul Cloudflare Access înainte să servească pagina), la /acte* (paginile actelor, de la serverul de pe VM,
  // worker/acte.ts) și la /documente/* (copiile noastre ale PDF-urilor parlamentare, din R2, worker/documente.ts); restul
  // cererilor vin direct din out/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lastraja",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/acte", "/acte/*", "/documente/*"]
  },
  // Copiile documentelor parlamentare (data/pdfs), urcate de scripts/straja-documente.mjs --arhiva; NAS-ul e arhiva principală.
  "r2_buckets": [{ "binding": "DOCUMENTE", "bucket_name": "destraja-documente" }],
  "d1_databases": [{ "binding": "DB", "database_name": "lastraja", "database_id": "44d27d60-fce7-485b-ab48-b632623c36ef", "migrations_dir": "migrations" }],
  // Cel mult 5 rapoarte pe minut de la aceeași adresă, în fiecare locație Cloudflare.
  "ratelimits": [
    { "name": "REPORT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "SUBSCRIBE_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "SEARCH_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    // MCP-ul public (worker/mcp.ts): 180 de mesaje pe minut de la aceeași adresă (sau prefix IPv6 /64). Claude și ChatGPT
    // cheamă serverele MCP din adrese comune ale lor, iar o conversație trimite 4–10 mesaje; citirile sunt fișiere statice.
    { "name": "MCP_LIMIT", "namespace_id": "1004", "simple": { "limit": 180, "period": 60 } },
    // Căutarea după sens din MCP (cauta.destraja.ro, care are și limitele lui): 30 pe minut de la aceeași adresă; peste
    // limită, MCP-ul caută în titluri și spune asta în răspuns.
    { "name": "MCP_SEARCH_LIMIT", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } }
  ],
  // E-mailurile pleacă prin Resend (worker/mail.ts), cu secretele RESEND_API_KEY și RESEND_WEBHOOK_SECRET puse cu
  // `wrangler secret put`; nu au nevoie de nimic aici. La fel panoul /admin (worker/access.ts, ADMIN-SETUP.md):
  // ACCESS_TEAM_DOMAIN, ACCESS_AUD și ADMIN_EMAILS sunt secrete, ca adresa să nu stea în repo.
  // Originea paginilor de acte: tunelul destraja-search spre acte-server (127.0.0.1:8090 pe VM). Răspunde doar cererilor
  // cu secretul ACTE_ORIGIN_KEY în X-Acte-Key (acte-server/vm/origin-key.sh îl pune de ambele părți); altfel 404.
  "vars": { "ACTE_ORIGIN": "https://acte-origin.destraja.ro" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Confirmările de abonare rămase la coadă când trimiterea n-a mers din motive care nu țin de adresă (worker/subscribe.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [
    { "pattern": "destraja.ro", "custom_domain": true },
    // Domeniile vechi și cel pentru Moldova: paginile lor trimit 301 spre destraja.ro (reguli Single Redirect pe zonă);
    // /api/* rămâne aici, ca linkurile de dezabonare din e-mailurile deja trimise să meargă în continuare.
    { "pattern": "lastraja.ro", "custom_domain": true },
    { "pattern": "destraja.md", "custom_domain": true },
    // www.destraja.ro și destrajă.ro (cu ă, aici în punycode), cu www: tot 301 spre destraja.ro, din aceleași reguli.
    { "pattern": "www.destraja.ro", "custom_domain": true },
    { "pattern": "xn--destraj-f4a.ro", "custom_domain": true },
    { "pattern": "www.xn--destraj-f4a.ro", "custom_domain": true }
  ]
}
